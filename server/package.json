{
  "name": "radiant-reader-backend",
  "version": "1.0.0",
  "description": "Backend for WebtoonReaderKotlin app - Handles extensions and sync",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "prestart": "npm run build:sdk",
    "build:sdk": "npm --prefix ../extension-sdk run build"
  },
  "dependencies": {
    "@radiant/extension-sdk": "file:../extension-sdk",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.7",
    "body-parser": "^1.20.2"
  }
}
